#!/usr/bin/env bash

<%
image_path =
  if context.container_image == "custom"
    context.custom_image.to_s.strip
  else
    context.container_image
  end

if image_path.empty?
  raise "Custom image selected but no image path provided"
end
%>

echo "Running on: $(hostname)"
echo "Using container image: <%= image_path %>"

module load apptainer

# Create Config File
cat <<-EOF >./rserver.conf
	server-user=$(whoami)
  www-port=${port}
	auth-none=0
	auth-pam-helper-path=${PWD}/bin/auth
	auth-encrypt-password=0
	auth-timeout-minutes=0
	server-app-armor-enabled=0
EOF

# Create Session Config File
cat <<-EOF >./rsession.conf
	session-timeout-minutes=0
	session-save-action-default=no
EOF

# Create Log Config File (debug, info, warn, error)
cat <<-EOF >./logging.conf
	[*]
	log-level=info
	logger-type=file
	log-dir=$PWD/sessions
EOF

# Apptainer bind paths
BIND_PATHS=(
	"$TMPDIR:/tmp"
	"$PWD/rserver.conf:/etc/rstudio/rserver.conf"
	"$PWD/rsession.conf:/etc/rstudio/rsession.conf"
	"$PWD/logging.conf:/etc/rstudio/logging.conf"
)

# Join bind paths elements by comma
BIND_PATH="$(IFS=,; printf '%s' "${BIND_PATHS[*]}")"

# Shared Apptainer arguments for both GPU and non-GPU execution
APPTAINER_ARGS=(
	--bind "$BIND_PATH"
	--scratch /run,/var/lib/rstudio-server
	"<%= image_path %>"
)

echo "Starting RStudio Server at: $(date)"

if [ -n "$CUDA_VISIBLE_DEVICES" ]; then
	apptainer exec --nv "${APPTAINER_ARGS[@]}" rserver
else
	apptainer exec "${APPTAINER_ARGS[@]}" rserver
fi
